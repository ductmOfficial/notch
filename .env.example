# Local development only. Copy to `.env` and adjust if needed: cp .env.example .env
# These credentials are for the PostgreSQL container on your machine; never reuse them in production.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5433

# Connection string for the web app and the db scripts. Keep it in sync with the values above.
# Without Docker, a PGlite folder works too (relative to the repository root): DATABASE_URL=pglite:.data/pglite
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app

# Seed file with a child's real records (see packages/db/README.md). Keep it OUTSIDE the repository.
# Relative paths are resolved from the repository root.
NOTCH_SEED_FILE=../notch-private/child.json

# Sign-in (Better Auth). A long random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The address the app is served from; sign-in links point here.
BETTER_AUTH_URL=http://localhost:3000
# Who may sign in: comma-separated emails. Empty means nobody.
NOTCH_ALLOWED_EMAILS=
# Sending the sign-in email through Resend. Without a key, the link is printed in the dev console.
RESEND_API_KEY=
MAIL_FROM=Notch <onboarding@resend.dev>
